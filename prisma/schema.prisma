// npx prisma generate # generates the Prisma Client based on the schema
// npx prisma db push # pushes the schema to the database (creates tables, etc.)
// npx tsx prisma/seed.ts   # re-seeds if seed.ts is modified
// npx tsx --env-file=.env.local prisma/seed.ts # re-seeds with .env.local (e.g. for different DB connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id
  currentStreak       Int                 @default(0)
  longestStreak       Int                 @default(0)
  stars               Int                 @default(10)
  lastSolvedAt        DateTime?
  lastMakeupDate      String?
  lastNoProblemBonus  String?
  lastLoginBonus      String?
  streakFreezeCount   Int                 @default(0)
  challengeMode       ChallengeMode       @default(NORMAL)
  preferredDifficulty PreferredDifficulty @default(ANY)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt

  solves           Solve[]
  hintPurchases    HintPurchase[]
  starTransactions StarTransaction[]
  quizAttempts     QuizAttempt[]
  practiceMode     PracticeMode      @default(DSA)
}

model StarTransaction {
  id        String                @id @default(cuid())
  userId    String
  amount    Int
  reason    StarTransactionReason
  meta      Json?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Problem {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String
  examples     Json       @default("[]")
  constraints  String     @default("")
  difficulty   Difficulty
  topics       Topic[]
  functionName String     @default("solution")
  starterCode  Json
  testCases    Json
  hints        Json
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  dailySlots DailyProblem[]
  solves     Solve[]
}

model DailyProblem {
  id         String     @id @default(cuid())
  date       String
  difficulty Difficulty
  problemId  String
  problem    Problem    @relation(fields: [problemId], references: [id])

  @@unique([date, difficulty])
}

model AppConfig {
  key   String @id
  value String
}

model Solve {
  id            String        @id @default(cuid())
  userId        String
  problemId     String
  code          String
  language      Language      @default(JAVASCRIPT)
  passed        Boolean
  usedHints     Boolean       @default(false)
  cleanSolve    Boolean       @default(false)
  challengeMode ChallengeMode @default(NORMAL)
  timeExpired   Boolean       @default(false)
  attempts      Int           @default(1)
  isMakeup      Boolean       @default(false)
  makeupDate    String?
  solvedAt      DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

model HintPurchase {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  tier      Int
  cost      Int
  boughtAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PreferredDifficulty {
  ANY
  EASY
  MEDIUM
  HARD
}

enum ChallengeMode {
  NORMAL
  HARD
}

enum Language {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CPP
  JAVA
}

enum Topic {
  ARRAYS
  STRINGS
  LINKED_LISTS
  TREES
  GRAPHS
  DYNAMIC_PROGRAMMING
  SORTING
  BINARY_SEARCH
  STACK_QUEUE
  HASH_MAP
  HEAPS
  TWO_POINTERS
  SLIDING_WINDOW
  DFS_BFS
  BACKTRACKING
  GREEDY
  RECURSION
  DIVIDE_AND_CONQUER
  BIT_MANIPULATION
  MATH
  TRIE
  UNION_FIND
  SEGMENT_TREE
  FENWICK_TREE
  MONOTONIC_STACK
  MONOTONIC_QUEUE
}

enum StarTransactionReason {
  SOLVE_CLEAN_NORMAL
  SOLVE_CLEAN_HARD
  SOLVE_HINTS_NORMAL
  SOLVE_HINTS_HARD
  HINT_PURCHASE
  MAKEUP_COST
  MAKEUP_REWARD
  STREAK_FREEZE_PURCHASE
  PROBLEM_SKIP
  PROBLEM_SKIP_USED
  DAILY_LOGIN_BONUS
  NO_PROBLEM_BONUS
  STREAK_MILESTONE
  FIRST_SOLVE_BONUS
  ADMIN_ADJUSTMENT
  QUIZ_REWARD
}

/////////////////////////////////////////////////////

model Quiz {
  id         String     @id @default(cuid())
  title      String
  topic      QuizTopic
  difficulty Difficulty
  questions  Json       @default("[]") // QuizQuestion[]
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  dailySlots DailyQuiz[]
  attempts   QuizAttempt[]
}

model DailyQuiz {
  id     String @id @default(cuid())
  date   String @unique
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String
  answers    Json // { questionIndex: number; selectedIndex: number }[]
  score      Int
  total      Int
  passed     Boolean
  stars      Int      @default(0)
  isMakeup   Boolean  @default(false)
  makeupDate String?
  solvedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@unique([userId, quizId])
}

// ── New enums ─────────────────────────────────────────────────────────────────

enum QuizTopic {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CSS
  HTML
  REACT
  NODE
  DATABASES
  SYSTEM_DESIGN
  GENERAL_CS
}

enum PracticeMode {
  DSA
  QUIZ
}
