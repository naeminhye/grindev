// pnpm prisma generate # generates the Prisma Client based on the schema
// pnpm prisma db push # pushes the schema to the database (creates tables, etc.)
// pnpm tsx prisma/seed.ts   # re-seeds if seed.ts is modified
// pnpm tsx --env-file=.env.local prisma/seed.ts # re-seeds with .env.local (e.g. for different DB connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id
  currentStreak       Int                 @default(0)
  longestStreak       Int                 @default(0)
  stars               Int                 @default(10)
  lastSolvedAt        DateTime?
  lastMakeupDate      String?
  lastNoProblemBonus  String?
  lastLoginBonus      String?
  streakFreezeCount   Int                 @default(0)
  challengeMode       ChallengeMode       @default(NORMAL)
  preferredDifficulty PreferredDifficulty @default(ANY)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  skipRequestedAt     DateTime?
  skippedProblemId    String?
  streakStatus        StreakStatus        @default(ACTIVE)
  streakAtRiskSince   DateTime? // timestamp when AT_RISK was triggered
  streakAtRiskDate    String? // YYYY-MM-DD — the missed day being protected
  frozenStreakValue   Int                 @default(0) // streak value preserved when FROZEN

  solves             Solve[]
  hintPurchases      HintPurchase[]
  starTransactions   StarTransaction[]
  quizAttempts       QuizAttempt[]
  practiceMode       PracticeMode         @default(DSA)
  preferredQuizTopic QuizTopic?
  problemReports     ProblemReport[]
  codeRedemptions    StarCodeRedemption[]
}

model StarTransaction {
  id        String                @id @default(cuid())
  userId    String
  amount    Int
  reason    StarTransactionReason
  meta      Json?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Problem {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String
  examples     Json       @default("[]")
  constraints  String     @default("")
  difficulty   Difficulty
  topics       Topic[]
  functionName String     @default("solution")
  starterCode  Json
  testCases    Json
  hints        Json
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  sourceName   String?
  sourceUrl    String?

  dailySlots DailyProblem[]
  solves     Solve[]
  reports    ProblemReport[]
}

model DailyProblem {
  id         String     @id @default(cuid())
  date       String
  difficulty Difficulty
  problemId  String
  problem    Problem    @relation(fields: [problemId], references: [id])

  @@unique([date, difficulty])
}

model AppConfig {
  key   String @id
  value String
}

model Solve {
  id            String        @id @default(cuid())
  userId        String
  problemId     String
  code          String
  language      Language      @default(JAVASCRIPT)
  passed        Boolean
  usedHints     Boolean       @default(false)
  cleanSolve    Boolean       @default(false)
  challengeMode ChallengeMode @default(NORMAL)
  timeExpired   Boolean       @default(false)
  attempts      Int           @default(1)
  isMakeup      Boolean       @default(false)
  makeupDate    String?
  solvedAt      DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

model HintPurchase {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  tier      Int
  cost      Int
  boughtAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PreferredDifficulty {
  ANY
  EASY
  MEDIUM
  HARD
}

enum ChallengeMode {
  NORMAL
  HARD
}

enum Language {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CPP
  JAVA
}

enum Topic {
  ARRAYS
  STRINGS
  LINKED_LISTS
  TREES
  GRAPHS
  DYNAMIC_PROGRAMMING
  SORTING
  BINARY_SEARCH
  STACK_QUEUE
  HASH_MAP
  HEAPS
  TWO_POINTERS
  SLIDING_WINDOW
  DFS_BFS
  BACKTRACKING
  GREEDY
  RECURSION
  DIVIDE_AND_CONQUER
  BIT_MANIPULATION
  MATH
  TRIE
  UNION_FIND
  SEGMENT_TREE
  FENWICK_TREE
  MONOTONIC_STACK
  MONOTONIC_QUEUE
}

enum StarTransactionReason {
  ADMIN_ADJUSTMENT
  AI_CODE_REVIEW
  AI_EXPLAIN
  DAILY_LOGIN_BONUS
  DOUBLE_STARS_PURCHASE
  DOUBLE_STARS_USED
  EXTRA_ATTEMPT_PURCHASE
  FIRST_SOLVE_BONUS
  HINT_DISCOUNT_PURCHASE
  HINT_DISCOUNT_USED
  HINT_PURCHASE
  MAKEUP_COST
  MAKEUP_REWARD
  NO_PROBLEM_BONUS
  PROBLEM_SKIP
  PROBLEM_SKIP_USED
  QUIZ_REWARD
  REPORT_ACCEPTED
  SOLVE_CLEAN_HARD
  SOLVE_CLEAN_NORMAL
  SOLVE_HINTS_HARD
  SOLVE_HINTS_NORMAL
  STAR_CODE_REDEMPTION
  STREAK_FREEZE_PURCHASE
  STREAK_FREEZE_USED
  STREAK_MILESTONE
}

enum StreakStatus {
  ACTIVE // streak is current and intact
  AT_RISK // missed a day, awaiting user decision (shield or make-up)
  FROZEN // shield applied, must solve today to thaw
  BROKEN // missed too long ago, will reset on next solve
}

/////////////////////////////////////////////////////

model Quiz {
  id         String     @id @default(cuid())
  title      String
  topic      QuizTopic
  difficulty Difficulty
  questions  Json       @default("[]") // QuizQuestion[]
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  dailySlots DailyQuiz[]
  attempts   QuizAttempt[]
}

model DailyQuiz {
  id     String @id @default(cuid())
  date   String @unique
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String
  answers    Json // { questionIndex: number; selectedIndex: number }[]
  score      Int
  total      Int
  passed     Boolean
  stars      Int      @default(0)
  isMakeup   Boolean  @default(false)
  makeupDate String?
  solvedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@unique([userId, quizId])
}

// ── New enums ─────────────────────────────────────────────────────────────────

enum QuizTopic {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CSS
  HTML
  REACT
  NODE
  DATABASES
  SYSTEM_DESIGN
  GENERAL_CS
}

enum PracticeMode {
  DSA
  QUIZ
}

model ProblemReport {
  id          String       @id @default(cuid())
  userId      String
  problemId   String
  reason      ReportReason
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

enum ReportReason {
  WRONG_TEST_CASE
  WRONG_EXPECTED_OUTPUT
  UNCLEAR_DESCRIPTION
  BROKEN_STARTER_CODE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model StarCode {
  id          String               @id @default(cuid())
  code        String               @unique
  stars       Int
  maxUses     Int?
  usedCount   Int                  @default(0)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  createdBy   String
  note        String?
  redemptions StarCodeRedemption[]
}

model StarCodeRedemption {
  id         String   @id @default(cuid())
  codeId     String
  userId     String
  redeemedAt DateTime @default(now())
  code       StarCode @relation(fields: [codeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([codeId, userId])
}
