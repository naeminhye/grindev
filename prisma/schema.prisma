// npx prisma generate # generates the Prisma Client based on the schema
// npx prisma db push # pushes the schema to the database (creates tables, etc.)
// npx tsx prisma/seed.ts   # re-seeds if seed.ts is modified
// npx tsx --env-file=.env.local prisma/seed.ts # re-seeds with .env.local (e.g. for different DB connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id
  currentStreak  Int           @default(0)
  longestStreak  Int           @default(0)
  stars          Int           @default(10)
  lastSolvedAt   DateTime?
  lastMakeupDate String? // "YYYY-MM-DD" — tracks if makeup reward already given today
  challengeMode  ChallengeMode @default(NORMAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  solves        Solve[]
  hintPurchases HintPurchase[]
}

model Problem {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  difficulty  Difficulty
  topic       Topic
  starterCode Json // Record<Language, string> — per-language starter code
  testCases   Json // Array<{ input, expected }>
  hints       Json // Array<{ tier, cost, content }>
  createdAt   DateTime   @default(now())

  dailySlots DailyProblem[]
  solves     Solve[]
}

model DailyProblem {
  id        String  @id @default(cuid())
  date      String  @unique
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])
}

model Solve {
  id            String        @id @default(cuid())
  userId        String
  problemId     String
  code          String
  language      Language      @default(JAVASCRIPT)
  passed        Boolean
  usedHints     Boolean       @default(false)
  cleanSolve    Boolean       @default(false)
  challengeMode ChallengeMode @default(NORMAL)
  timeExpired   Boolean       @default(false)
  attempts      Int           @default(1)
  isMakeup      Boolean       @default(false)
  makeupDate    String? // "YYYY-MM-DD" of the original missed day
  solvedAt      DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

model HintPurchase {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  tier      Int
  cost      Int
  boughtAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Topic {
  ARRAYS
  STRINGS
  LINKED_LISTS
  TREES
  GRAPHS
  DYNAMIC_PROGRAMMING
  SORTING
  BINARY_SEARCH
  STACK_QUEUE
  HASH_MAP
}

enum ChallengeMode {
  NORMAL
  HARD
}

enum Language {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CPP
  JAVA
}
